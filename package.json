{
  "name": "puzzle-timer",
  "version": "0.0.7",
  "description": "A native GTK4/libadwaita speedcubing timer — WCA scrambles for 206 puzzles, sessions and statistics, in the spirit of csTimer.",
  "homepage": "https://github.com/xlucn/puzzle-timer#readme",
  "bugs": {
    "url": "https://github.com/xlucn/puzzle-timer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xlucn/puzzle-timer.git"
  },
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "npm run dev:css-reload",
    "dev:css-reload": "cross-env NODE_ENV=development node --import tsx --import node-gtk/register src/main.ts",
    "dev:app-reload": "cross-env NODE_ENV=development node --import tsx --import node-gtk/register --watch src/main.ts",
    "start": "node --import tsx --import node-gtk/register src/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate-types": "node-gtk generate-types Gtk-4.0 Adw-1",
    "postinstall": "npm run generate-types"
  },
  "dependencies": {
    "cstimer_module": "^0.1.5",
    "node-gtk": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "node-gtk@4.1.1": true,
    "esbuild@0.28.2": true
  }
}
