# Maintainer: Lu Xu
#
# This is the AUR repository's content, kept in the source tree so the recipe
# is reviewed next to the code it packages. Only the PKGBUILD lives here:
# `.SRCINFO` is generated when it is needed (`makepkg --printsrcinfo >
# .SRCINFO`) and is not part of the source tree.
#
# The package tracks `main` and builds through Meson, which is the project's
# own install path: Meson places the binary, the desktop entry, the icon set
# and the gettext catalogs where a session looks for them, and bakes the
# install prefix in so the binary finds `$prefix/share/locale` at runtime. A
# `cargo build` on its own would read a build directory that does not exist on
# the target machine and quietly fall back to English.

pkgname=puzzle-timer-git
pkgver=0.4.0
pkgrel=1
pkgdesc="Native GTK4/libadwaita speedcubing timer in the spirit of csTimer (development version)"
arch=('x86_64')
url="https://github.com/xlucn/puzzle-timer"
license=('GPL-3.0-or-later')
# webkitgtk-6.0 is what ships libjavascriptcoregtk-6.0: the scramble module
# runs in the system JSC instead of a Rust-linked V8, which keeps the binary
# at a couple of megabytes and makes this the one heavy dependency.
depends=('gtk4' 'libadwaita' 'webkitgtk-6.0')
# rust provides cargo; gettext compiles the catalogs and blueprint-compiler
# the solve editor's template, both during `cargo build`.
makedepends=('rust' 'pkgconf' 'meson' 'git' 'gettext' 'blueprint-compiler')
provides=('puzzle-timer')
conflicts=('puzzle-timer')
source=("$pkgname::git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # The version lives in Cargo.toml, which is the only place the app reads it
  # from; the commit count keeps every build sorting above the previous one and
  # the hash says which tree it is.
  local version
  version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -1)
  printf '%s.r%s.g%s\n' "$version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$pkgname"
  meson setup build --buildtype=release --prefix=/usr
  meson compile -C build
}

package() {
  cd "$pkgname"
  DESTDIR="$pkgdir" meson install -C build
}
