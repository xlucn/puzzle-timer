{
  "app-id": "io.github.xlucn.PuzzleTimer",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "puzzle-timer",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--socket=pulseaudio"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": ["--share=network"],
    "env": {
      "CARGO_HOME": "/run/build/puzzle-timer/cargo"
    }
  },
  "modules": [
    {
      "name": "puzzle-timer",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": ["--buildtype=release"],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [".git", "builddir", "target", ".flatpak-builder"]
        }
      ]
    }
  ]
}
